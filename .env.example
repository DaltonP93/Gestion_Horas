# =============================================================
# NUEVO SISTEMA DE ASISTENCIA — Variables de Entorno
# Copia este archivo como .env y completa los valores
# =============================================================

# ─── Base de Datos NUEVA (MySQL propio del nuevo sistema) ─────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asistencia
DB_USER=asistencia_user
DB_PASSWORD=password_seguro_aqui
DB_ROOT_PASSWORD=rootpass_cambia_esto

# ─── Base de Datos ORIGEN: att2000 (SQL Server del ZK) ───────
# SOLO LECTURA — El nuevo sistema NUNCA escribe aquí
ATT_HOST=ADVENTISTA          # Nombre del servidor SQL Server (o IP)
ATT_PORT=1433                # Puerto SQL Server (default: 1433)
ATT_USER=sa                  # Usuario SQL Server
ATT_PASSWORD=                # Contraseña del sa
ATT_DATABASE=att2000         # Base de datos del ZK Attendance

# ─── Redis (cache + pub/sub) ─────────────────────────────────
# Obligatoria: docker-compose exige REDIS_PASSWORD (falla el arranque si falta).
REDIS_PASSWORD=genera_un_string_aleatorio_para_redis

# ─── JWT ─────────────────────────────────────────────────────
# Genera secretos largos y aleatorios, p. ej.:  openssl rand -hex 32
JWT_SECRET=genera_un_string_aleatorio_largo_aqui
JWT_REFRESH_SECRET=otro_string_aleatorio_diferente

# ─── URLs ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
ANALYTICS_URL=http://localhost:5000
SOCKET_URL=http://localhost:4000

# ─── Claves internas entre servicios ─────────────────────────
# Obligatorias en docker-compose; usa valores largos y únicos por entorno.
# El servicio analytics ahora rechaza toda petición si ANALYTICS_API_KEY no
# está definida (fail-closed) y admite la clave por header X-API-Key.
BRIDGE_API_KEY=clave_puente_zkteco
ANALYTICS_API_KEY=genera_un_string_aleatorio_para_analytics

# ─── Relojes ZKTeco (para el Bridge si se usa polling directo)
ZKTECO_DEVICES=172.16.20.160,172.16.20.162,172.16.20.161
ZKTECO_PORT=4370
ZKTECO_POLL_INTERVAL=30000
