# =============================================================
#  SisHoras WEB — Variables de Entorno
#  Copia este archivo como .env.local y completá los valores.
#  NUNCA commitees .env.local al repo (ya está en .gitignore).
# =============================================================

NODE_ENV=development

# ─── URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Las variables NEXT_PUBLIC_* son visibles al cliente. NO poner secretos.
