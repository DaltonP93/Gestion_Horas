# ── ZKTeco Bridge ────────────────────────────────────────────────────
# Copiar a bridge/.env y completar. NO commitear bridge/.env.

# ── Relojes ──────────────────────────────────────────────────────────
# ÚNICA fuente de relojes del Bridge. Sin esta variable el Bridge arranca
# DEGRADADO: /health responde status=degraded y configured_devices=0, y no se
# intenta ninguna conexión. No hay reloj por defecto — antes había uno de
# prueba y volvía mentiroso al health.
#
# Formato por entrada:  [nombre@]host[:puerto][#serial]
#   - nombre  opcional, sirve para leer los logs y la UI
#   - puerto  opcional, por defecto 4370
#   - serial  opcional, debe ser único
#
# Ejemplo con los relojes reales:
# ZKTECO_DEVICES=Gerencia@10.0.0.11:4370,Comedor@10.0.0.12:4370,Lavadero@10.0.0.13:4370
#
# Forma JSON equivalente (si se prefiere):
# ZKTECO_DEVICES=[{"name":"Gerencia","ip":"10.0.0.11","port":4370}]
ZKTECO_DEVICES=

# Reloj ficticio para desarrollo. Requiere el valor exacto "true" y NO se
# admite con NODE_ENV=production ni siquiera con la flag puesta.
# BRIDGE_ALLOW_TEST_DEVICE=true

# ── Red ──────────────────────────────────────────────────────────────
BRIDGE_API_PORT=8081          # API del Bridge que consume el core
BRIDGE_BIND=127.0.0.1         # loopback: el core corre en el mismo host
ZKTECO_PUSH_PORT=8080         # puerto donde los relojes hacen PUSH

# Clave compartida con la API. Generar con: openssl rand -hex 32
# Debe coincidir con BRIDGE_API_KEY de api/.env
BRIDGE_API_KEY=

# ── Polling ──────────────────────────────────────────────────────────
# Desactivado por defecto: el protocolo ZKTeco admite UNA sola conexión TCP,
# y con polling activo la UI no puede conectarse bajo demanda.
ZKTECO_AUTO_POLL=false
ZKTECO_POLL_INTERVAL=60000

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Alerta si un reloj deja de mandar heartbeat (ms)
HEARTBEAT_ALERT_MS=900000

# ── Outbox local (DESCONECTADO) ──────────────────────────────────────
# Cola durable en SQLite para guardar una marcación ANTES de transmitirla y
# borrarla sólo tras el ACK del servidor.
#
# Estado: implementado pero NO enganchado a nada. No lo llama el PUSH, ni el
# polling, ni la API, ni Redis, ni MySQL. Con la flag apagada no se crea el
# archivo ni se abre SQLite.
BRIDGE_OUTBOX_ENABLED=false

# Ruta del archivo. Sin ella el Outbox no arranca — no se adivina ninguna.
# Debe estar en un disco local, no en un montaje de red: SQLite necesita
# bloqueo de archivo real.
# BRIDGE_OUTBOX_PATH=/var/lib/sishoras/outbox.db

# Tiempo tras el cual un lote reclamado se da por muerto y vuelve a pending
# (el proceso murió con el lote en vuelo). Por defecto 300000 (5 min).
# BRIDGE_OUTBOX_CLAIM_TTL_MS=300000

# Intentos antes de mandar una marcación a dead_letter. Por defecto 10.
# BRIDGE_OUTBOX_MAX_ATTEMPTS=10
