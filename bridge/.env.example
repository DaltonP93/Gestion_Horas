# ── ZKTeco Bridge ────────────────────────────────────────────────────
# Copiar a bridge/.env y completar. NO commitear bridge/.env.

# ── Relojes ──────────────────────────────────────────────────────────
# ÚNICA fuente de relojes del Bridge. Sin esta variable el Bridge arranca
# DEGRADADO: /health responde status=degraded y configured_devices=0, y no se
# intenta ninguna conexión. No hay reloj por defecto — antes había uno de
# prueba y volvía mentiroso al health.
#
# Formato por entrada:  [nombre@]host[:puerto][#serial]
#   - nombre  opcional, sirve para leer los logs y la UI
#   - puerto  opcional, por defecto 4370
#   - serial  opcional, debe ser único
#
# Ejemplo con los relojes reales:
# ZKTECO_DEVICES=Gerencia@10.0.0.11:4370,Comedor@10.0.0.12:4370,Lavadero@10.0.0.13:4370
#
# Forma JSON equivalente (si se prefiere):
# ZKTECO_DEVICES=[{"name":"Gerencia","ip":"10.0.0.11","port":4370}]
ZKTECO_DEVICES=

# Reloj ficticio para desarrollo. Requiere el valor exacto "true" y NO se
# admite con NODE_ENV=production ni siquiera con la flag puesta.
# BRIDGE_ALLOW_TEST_DEVICE=true

# ── Red ──────────────────────────────────────────────────────────────
BRIDGE_API_PORT=8081          # API del Bridge que consume el core
BRIDGE_BIND=127.0.0.1         # loopback: el core corre en el mismo host
ZKTECO_PUSH_PORT=8080         # puerto donde los relojes hacen PUSH

# Clave compartida con la API. Generar con: openssl rand -hex 32
# Debe coincidir con BRIDGE_API_KEY de api/.env
BRIDGE_API_KEY=

# ── Polling ──────────────────────────────────────────────────────────
# Desactivado por defecto: el protocolo ZKTeco admite UNA sola conexión TCP,
# y con polling activo la UI no puede conectarse bajo demanda.
ZKTECO_AUTO_POLL=false
ZKTECO_POLL_INTERVAL=60000

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Alerta si un reloj deja de mandar heartbeat (ms)
HEARTBEAT_ALERT_MS=900000

# ── Outbox local (DESCONECTADO) ──────────────────────────────────────
# Cola durable en SQLite para guardar una marcación ANTES de transmitirla y
# borrarla sólo tras el ACK del servidor.
#
# Estado: implementado pero NO enganchado a nada. No lo llama el PUSH, ni el
# polling, ni la API, ni Redis, ni MySQL. Con la flag apagada no se crea el
# archivo ni se abre SQLite.
BRIDGE_OUTBOX_ENABLED=false

# Ruta del archivo. Sin ella el Outbox no arranca — no se adivina ninguna.
# Debe estar en un disco local, no en un montaje de red: SQLite necesita
# bloqueo de archivo real.
# BRIDGE_OUTBOX_PATH=/var/lib/sishoras/outbox.db

# Tiempo tras el cual un lote reclamado se da por muerto y vuelve a pending
# (el proceso murió con el lote en vuelo). Por defecto 300000 (5 min).
# BRIDGE_OUTBOX_CLAIM_TTL_MS=300000

# Intentos antes de mandar una marcación a dead_letter. Por defecto 10.
# BRIDGE_OUTBOX_MAX_ATTEMPTS=10

# ── PUSH observe-only (VACÍO) ────────────────────────────────────────
# Relojes de los que se RECIBE el PUSH pero cuya asistencia NO se publica.
#
# Hace falta porque la sombra es pasiva pero el servidor sobre el que cuelga
# no lo es: después de shadow.capture() viene publishAttendance(), que hace
# XADD a stream:attendance y PUBLISH a attendance:new. Configurar un reloj
# para ADMS con la sombra encendida no lo vuelve observado — lo vuelve un
# SEGUNDO PRODUCTOR de asistencia mientras el polling sigue siendo el
# autoritativo.
#
# BRIDGE_SHADOW_ENABLED=true NO implica observe-only. Son dos decisiones
# distintas: una dice qué se guarda para comparar, la otra qué NO se publica.
#
# Para un reloj nombrado acá: se acepta su registro, su heartbeat y su ATTLOG,
# se ejecuta la sombra y se responde OK — pero no hay publishAttendance, ni
# XADD, ni PUBLISH, ni siquiera el SET NX del dedupe (que también es una
# escritura en Redis).
#
# Es allowlist POR RELOJ, nunca un interruptor global: apagar de más la
# publicación perdería marcaciones en silencio —el reloj recibe OK, se ve
# tráfico, y la asistencia no aparece—. Cada token puede nombrar al reloj por
# serial, por nombre o por IP, con la misma canonización que usa la sombra.
#
# VACÍO = ningún reloj = comportamiento histórico exacto.
#
# Para observar Gerencia sin que publique:
# BRIDGE_PUSH_OBSERVE_ONLY_ALLOWLIST=Gerencia
BRIDGE_PUSH_OBSERVE_ONLY_ALLOWLIST=

# ── Modo sombra (APAGADO) ────────────────────────────────────────────
# Guarda una COPIA normalizada de lo que ya llega por PUSH, para poder
# compararla más adelante contra lo que ve el polling. Es observación, no un
# productor nuevo: no inserta en attendance, no toca daily_summary, no escribe
# en Redis, no hace POST a la API, no manda ACK al reloj, no apaga el polling
# y no borra logs del reloj.
#
# Es INDEPENDIENTE del Outbox: archivo, flag y tabla separados. Encender la
# sombra no enciende la cola de transmisión.
#
# Con la flag distinta de "true" es un no-op real: no se crea el archivo, no se
# carga better-sqlite3 y no se intercepta el PUSH.
BRIDGE_SHADOW_ENABLED=false

# Relojes que se observan. Cada entrada puede nombrar al reloj por serial, por
# nombre (el de ZKTECO_DEVICES) o por IP; se comparan sin distinguir
# mayúsculas.
#
# IMPORTANTE — vacío significa NINGÚN reloj, no "todos". Es lo contrario de
# ZKTECO_PUSH_WHITELIST, y es a propósito: la whitelist filtra quién puede
# marcar, y esto decide sobre quién se acumula una copia de datos. Una copia
# nueva arranca de nadie y se enciende nombrando el reloj.
#
# Para arrancar sólo con Gerencia:
# BRIDGE_SHADOW_DEVICE_ALLOWLIST=Gerencia
BRIDGE_SHADOW_DEVICE_ALLOWLIST=

# Capturar el tráfico PUSH. Por defecto true, pero sólo tiene efecto con
# BRIDGE_SHADOW_ENABLED=true.
BRIDGE_SHADOW_CAPTURE_PUSH=true

# Archivo SQLite de la sombra. Sin esta ruta la sombra no arranca — no se
# adivina ninguna, igual que en el Outbox. Debe estar en disco local.
# NO puede ser el mismo archivo que BRIDGE_OUTBOX_PATH.
# BRIDGE_SHADOW_PATH=/var/lib/sishoras/shadow.db
#
# Retención: no hay limpieza automática. Se vacía sólo con
# POST /shadow/purge {"confirm":true} contra la API del Bridge (requiere
# x-api-key).
