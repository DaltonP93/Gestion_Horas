# =============================================================
#  SisHoras API — Variables de Entorno
#  Copia este archivo como .env y completá los valores en cada server.
#  NUNCA commitees .env al repo (ya está en .gitignore).
# =============================================================

NODE_ENV=production
PORT=4000
TZ=America/Asuncion

# ─── MySQL principal ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asistencia
DB_USER=asistencia_user
DB_PASSWORD=<generar_con_openssl_rand_-base64_24>

# ─── SQL Server att2000 (SOLO LECTURA) ────────────────────────
ATT_HOST=sqlserver.example.internal
ATT_PORT=1433
ATT_USER=sishoras_integration
ATT_PASSWORD=<CONFIGURAR_SOLO_EN_API_ENV>
ATT_DATABASE=att2000

# Integración LEGADA att2000 (contingencia/migración/recuperación histórica).
# Kill switch del PULL AUTOMÁTICO: por defecto DESHABILITADO. El cron de
# marcaciones att2000 se registra SÓLO si ATT2000_AUTO_PULL_ENABLED=true
# (y además hay ATT2000_PULL_CRON). Los endpoints manuales de /api/sync siguen
# operativos independientemente de este valor.
ATT2000_AUTO_PULL_ENABLED=false
# Expresión node-cron del pull automático (sólo aplica si el kill switch = true).
ATT2000_PULL_CRON=

# ─── Configuración laboral histórica ─────────────────────────
# Kill switch fail-closed. Sólo el string exacto "true" habilita
# crear/corregir/cerrar vigencias históricas. Mantener false durante FASE E
# hasta terminar preflight, migraciones y auditoría histórica.
WORKDAY_CONFIG_WRITE_ENABLED=false

# ─── Consola de activación de FASE E (rollout del motor) ─────
# MASTER-FLAG de la consola guiada de FASE E. Fail-closed: sólo el string exacto
# "true" habilita las acciones MUTANTES de /api/fase-e: flip del escritor hacia
# adelante, recálculo histórico y restore. NO aplica migraciones: la API ya no las
# aplica por HTTP (el endpoint fue retirado); las migraciones 083 + 084 las corre
# OPS con scripts/ops-migrate.sh (ver deploy/RUNBOOK-migraciones-fase-e-ops.md).
# Con este flag en false (default en TODOS lados), esas acciones responden 503 y
# sólo funcionan los endpoints de SOLO LECTURA (status/impacto/lotes). Es la mitad
# (b) de la doble compuerta; la (a) es RBAC super_admin. NO poner en "true" salvo
# en el momento exacto de una activación autorizada, con backup verificable.
FASE_E_ACTIVATION_ENABLED=false
# Cotas fail-closed de una operación mutante de la consola (recálculo/restore),
# además del rango (máx. 366 días). Si el alcance/plan supera la cota → error
# explícito y NO se escribe nada. Defaults del código: 2000 empleados / 200000
# celdas. Para el PILOTO productivo se configuran en el MÍNIMO (1 empleado / 2
# celdas = un día con su spillover); subir a producción con OK del propietario.
FASE_E_MAX_EMPLOYEES=2000
FASE_E_MAX_CELLS=200000

# Escritor "hacia adelante" del motor sobre daily_summary. Requiere AMBOS
# cerrojos para escribir:
#   1) este env kill-switch de OPERACIONES en "true" (no togglable por request), y
#   2) el setting de BD `fase_e_forward_enabled` en 'true' (lo flipea la consola,
#      migración 083). Con cualquiera en false se conserva el recálculo LEGACY.
WORKDAY_ENGINE_DAILY_SUMMARY_WRITE_ENABLED=false
# Persistencia de los estados non_working/unconfigured. Requiere la migración 074
# aplicada. Fail-closed: sólo "true" habilita.
WORKDAY_ENGINE_STATUS_074_ENABLED=false
# ─── Gobierno / organización (FASE F1) ───────────────────────
# Kill switch fail-closed de escritura de empresas y centros de costo.
# Sólo el string exacto "true" habilita crear/editar. La lectura y la
# autorización granular por permiso funcionan siempre. Mantener false por
# defecto durante el rollout.
GOVERNANCE_WRITE_ENABLED=false

# ─── Personas / candidatos / asignaciones (FASE F2) ──────────
# Kill switch fail-closed de escritura de candidatos y asignaciones (vigencias).
# Sólo el string exacto "true" habilita crear/editar/convertir. La lectura y la
# autorización granular funcionan siempre. Mantener false por defecto.
PEOPLE_WRITE_ENABLED=false

# ─── Calendario laboral (FASE F3) ────────────────────────────
# Kill switch fail-closed de escritura de calendarios y excepciones. Sólo el
# string exacto "true" habilita crear/editar. El resolutor efectivo y la lectura
# de jornada son de sólo lectura y funcionan siempre. Mantener false por defecto.
CALENDAR_WRITE_ENABLED=false

# Zona horaria civil de la empresa (para "hoy"); default America/Asuncion.
# COMPANY_TZ=America/Asuncion

# ─── Base de nómina — SANDBOX NO OFICIAL (FASE F4) ───────────
# Kill switch fail-closed de escritura de conceptos/períodos de nómina. Sólo el
# string exacto "true" habilita crear/transicionar. NO calcula liquidación
# oficial ni paga. Mantener false por defecto.
PAYROLL_WRITE_ENABLED=false
# Adaptadores de integración futura — TODOS apagados por defecto (fail-closed).
# IPS_INTEGRATION_ENABLED=false
# MTESS_INTEGRATION_ENABLED=false
# ESIGN_INTEGRATION_ENABLED=false
# BANK_INTEGRATION_ENABLED=false
# MULTICHANNEL_NOTIF_ENABLED=false
# PAYMENTS_INTEGRATION_ENABLED=false

# ─── JWT (generar con: openssl rand -base64 48) ───────────────
JWT_SECRET=<openssl_rand_-base64_48>
JWT_REFRESH_SECRET=<openssl_rand_-base64_48>

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── SMTP (Gmail/Outlook/Webmail) ─────────────────────────────
# Para Gmail usar "App password" desde myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sistema RH <noreply@empresa.com>

# ─── Claves internas (generar con openssl rand -hex 32) ───────
BRIDGE_API_KEY=<openssl_rand_-hex_32>
INTEGRATION_API_KEY=<openssl_rand_-hex_32>
ANALYTICS_API_KEY=<openssl_rand_-hex_32>

# ─── URLs públicas ────────────────────────────────────────────
FRONTEND_URL=https://tu-dominio.example
SOCKET_ORIGIN=https://tu-dominio.example
# Orígenes CORS adicionales, separados por coma (opcional).
# CORS_ORIGINS=https://tu-dominio.example,https://app.tu-dominio.example

# ─── ZKTeco Relojes (IPs de la LAN interna) ──────────────────
ZKTECO_PORT=4370
# Configurar las IPs desde la UI en Configuración → Relojes,
# NO hardcodear aquí (queda guardado en BD).

# ─── Firma del reporte mensual (html2pdf + pades-signer) ──────
# Fail-closed: sin SIGNING_MODE=pades_local, o sin las dos URLs, o sin los dos
# secretos, O SIN EL PIN del certificado, el reporte sale con firma SIMPLE (sello
# + hash) y nunca afirma firmar. Ver deploy/signing/README.md (servicios + contrato).
SIGNING_MODE=simple
# HTML2PDF_URL=http://127.0.0.1:3002            # sin /pdf; el adaptador lo agrega
# PADES_SIGNER_URL=http://127.0.0.1:3001        # sin /sign; el adaptador lo agrega
# HTML2PDF_SHARED_SECRET=<= SHARED_SECRET del contenedor html2pdf>
# PADES_SIGNER_SHARED_SECRET=<= SHARED_SECRET del contenedor pades-signer>
# [P1-D] PIN del cert firmante (fingerprint SHA-256, 64 hex; se toleran `:`). pades_local
# lo EXIGE: sin pin, o si el cert firmante no coincide, degrada a simple (nunca afirma PAdES).
# Obtener: openssl x509 -in cert.pem -noout -fingerprint -sha256 | sed 's/.*=//; s/://g'
# PADES_TRUSTED_CERT_SHA256=<fingerprint sha256 del certificado real>
# SIGNING_TIMEOUT_MS=15000
# SIGNING_PROVIDER_NAME=pades-local
# [SSRF] Los servicios de firma sólo se contactan si sus URLs apuntan a destinos
# LOCALES/PRIVADOS: loopback/rango privado (127.x, 10.x, 172.16–31.x, 192.168.x),
# `localhost`, un nombre de servicio de Docker de una sola etiqueta (p.ej.
# `html2pdf`, `pades-signer`) o un sufijo interno (.local/.internal/.svc). Las
# requests usan maxRedirects:0. Para permitir EXPLÍCITAMENTE otros hosts internos
# (coma-separados), usar SIGNING_ALLOWED_HOSTS. Un host público → degrada a simple.
# SIGNING_ALLOWED_HOSTS=html2pdf,pades-signer
# Overrides opcionales (defaults ya coinciden con el contrato real):
# HTML2PDF_PATH=/pdf   HTML2PDF_AUTH_HEADER=x-render-key   HTML2PDF_HTML_FIELD=html
# PADES_SIGNER_PATH=/sign   PADES_SIGNER_AUTH_HEADER=x-sign-key   PADES_FILE_FIELD=file
