# =============================================================
#  SisHoras API — Variables de Entorno
#  Copia este archivo como .env y completá los valores en cada server.
#  NUNCA commitees .env al repo (ya está en .gitignore).
# =============================================================

NODE_ENV=production
PORT=4000
TZ=America/Asuncion

# ─── MySQL principal ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asistencia
DB_USER=asistencia_user
DB_PASSWORD=<generar_con_openssl_rand_-base64_24>

# ─── SQL Server att2000 (SOLO LECTURA) ────────────────────────
ATT_HOST=sqlserver.example.internal
ATT_PORT=1433
ATT_USER=sishoras_integration
ATT_PASSWORD=<CONFIGURAR_SOLO_EN_API_ENV>
ATT_DATABASE=att2000

# Integración LEGADA att2000 (contingencia/migración/recuperación histórica).
# Kill switch del PULL AUTOMÁTICO: por defecto DESHABILITADO. El cron de
# marcaciones att2000 se registra SÓLO si ATT2000_AUTO_PULL_ENABLED=true
# (y además hay ATT2000_PULL_CRON). Los endpoints manuales de /api/sync siguen
# operativos independientemente de este valor.
ATT2000_AUTO_PULL_ENABLED=false
# Expresión node-cron del pull automático (sólo aplica si el kill switch = true).
ATT2000_PULL_CRON=

# ─── Configuración laboral histórica ─────────────────────────
# Kill switch fail-closed. Sólo el string exacto "true" habilita
# crear/corregir/cerrar vigencias históricas. Mantener false durante FASE E
# hasta terminar preflight, migraciones y auditoría histórica.
WORKDAY_CONFIG_WRITE_ENABLED=false

# ─── Gobierno / organización (FASE F1) ───────────────────────
# Kill switch fail-closed de escritura de empresas y centros de costo.
# Sólo el string exacto "true" habilita crear/editar. La lectura y la
# autorización granular por permiso funcionan siempre. Mantener false por
# defecto durante el rollout.
GOVERNANCE_WRITE_ENABLED=false

# ─── Personas / candidatos / asignaciones (FASE F2) ──────────
# Kill switch fail-closed de escritura de candidatos y asignaciones (vigencias).
# Sólo el string exacto "true" habilita crear/editar/convertir. La lectura y la
# autorización granular funcionan siempre. Mantener false por defecto.
PEOPLE_WRITE_ENABLED=false

# ─── Calendario laboral (FASE F3) ────────────────────────────
# Kill switch fail-closed de escritura de calendarios y excepciones. Sólo el
# string exacto "true" habilita crear/editar. El resolutor efectivo y la lectura
# de jornada son de sólo lectura y funcionan siempre. Mantener false por defecto.
CALENDAR_WRITE_ENABLED=false

# Zona horaria civil de la empresa (para "hoy"); default America/Asuncion.
# COMPANY_TZ=America/Asuncion

# ─── Base de nómina — SANDBOX NO OFICIAL (FASE F4) ───────────
# Kill switch fail-closed de escritura de conceptos/períodos de nómina. Sólo el
# string exacto "true" habilita crear/transicionar. NO calcula liquidación
# oficial ni paga. Mantener false por defecto.
PAYROLL_WRITE_ENABLED=false
# Adaptadores de integración futura — TODOS apagados por defecto (fail-closed).
# IPS_INTEGRATION_ENABLED=false
# MTESS_INTEGRATION_ENABLED=false
# ESIGN_INTEGRATION_ENABLED=false
# BANK_INTEGRATION_ENABLED=false
# MULTICHANNEL_NOTIF_ENABLED=false
# PAYMENTS_INTEGRATION_ENABLED=false

# ─── JWT (generar con: openssl rand -base64 48) ───────────────
JWT_SECRET=<openssl_rand_-base64_48>
JWT_REFRESH_SECRET=<openssl_rand_-base64_48>

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── SMTP (Gmail/Outlook/Webmail) ─────────────────────────────
# Para Gmail usar "App password" desde myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sistema RH <noreply@empresa.com>

# ─── Claves internas (generar con openssl rand -hex 32) ───────
BRIDGE_API_KEY=<openssl_rand_-hex_32>
INTEGRATION_API_KEY=<openssl_rand_-hex_32>
ANALYTICS_API_KEY=<openssl_rand_-hex_32>

# ─── URLs públicas ────────────────────────────────────────────
FRONTEND_URL=https://sishoras.saa.com.py
SOCKET_ORIGIN=https://sishoras.saa.com.py

# ─── ZKTeco Relojes (IPs de la LAN interna) ──────────────────
ZKTECO_PORT=4370
# Configurar las IPs desde la UI en Configuración → Relojes,
# NO hardcodear aquí (queda guardado en BD).
