# Ajustes no secretos. Sustituir placeholders fuera del repositorio.
PM2_HOME=/ABSOLUTE_PRIVATE_PATH/pm2
PM2_APP_NAMES=REPLACE_WITH_COMMA_SEPARATED_NAMES
API_HEALTH_URL=http://127.0.0.1:PORT/PATH
WEB_HEALTH_URL=http://127.0.0.1:PORT/PATH
BRIDGE_HEALTH_URL=http://127.0.0.1:PORT/PATH
ANALYTICS_HEALTH_URL=http://127.0.0.1:PORT/PATH
ANALYTICS_PROTECTED_URL=http://127.0.0.1:PORT/PROTECTED_PATH
CHECK_BACKUP=1
BACKUP_DIR=/var/backups/REPLACE_ME
DB_NAME=REPLACE_ME
MAX_BACKUP_AGE_SECONDS=28800
HTTP_TIMEOUT=10
# SHA esperado opcional y URL publica opcional.
EXPECTED_RELEASE_SHA=
EXTERNAL_HEALTH_URL=
