# deploy/signing/.env — parámetros del compose de firma (copiar a .env, NO versionar)

# Imágenes reales de tus servicios (desde Portainer / tu build). Ejemplos:
#   HTML2PDF_IMAGE=html2pdf:local
#   PADES_SIGNER_IMAGE=pades-signer:local
HTML2PDF_IMAGE=html2pdf:local
PADES_SIGNER_IMAGE=pades-signer:local

# Puertos de host (por defecto iguales a tu otro servidor).
HTML2PDF_HOST_PORT=3002
PADES_SIGNER_HOST_PORT=3001

# Directorio local con el certificado de firma PAdES (montado de solo lectura).
# NUNCA versionar el certificado ni su passphrase.
PADES_CERT_DIR=./certs

# PIN del certificado de firma (va en el .env del backend api/, no en este compose):
#   PADES_TRUSTED_CERT_SHA256=<fingerprint sha256 del cert real, 64 hex>
# Obtener: openssl x509 -in ./certs/cert.pem -noout -fingerprint -sha256 | sed 's/.*=//; s/://g'
# pades_local lo EXIGE; sin pin o con cert que no coincide → firma simple (fail-closed).
